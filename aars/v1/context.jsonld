{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "aars": "https://schema.obquan.com/aars/v1#",
    "airo": "https://w3id.org/airo#",
    "airo_uc": "https://w3id.org/AIRO#",
    "prov": "http://www.w3.org/ns/prov#",
    "vc": "https://www.w3.org/2018/credentials#",
    "dpv": "https://w3id.org/dpv#",
    "dpv-gdpr": "https://w3id.org/dpv/dpv-gdpr#",
    "dpv-ai": "https://w3id.org/dpv/dpv-ai#",
    "eu-aiact": "https://w3id.org/dpv/legal/eu/aiact#",
    "vair": "https://w3id.org/vair#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id": "@id",
    "type": "@type",

    "Agent": "aars:Agent",
    "AISystem": "airo:AISystem",
    "CallChainTrace": "aars:CallChainTrace",
    "RevocationEvent": "aars:RevocationEvent",
    "RevocationVector": "aars:RevocationEvent",

    "owning_team": "aars:provider",
    "deployer": "aars:deployer",
    "team_did": "@id",
    "name": "rdfs:label",
    "contact_email": "aars:contactEmail",
    "ownership_attestation": "aars:ownershipAttestation",
    "ownership_attestation_signature": "aars:ownershipAttestation",
    "attestation": "aars:governanceAttestation",
    "engineering_signoff_key": "aars:engineeringSignoffKey",
    "business_signoff_key": "aars:businessSignoffKey",
    "certification_expires": { "@id": "aars:certificationExpires", "@type": "xsd:dateTime" },

    "endpoints": "@nest",
    "api_endpoint": { "@id": "aars:apiEndpoint", "@type": "@id", "@nest": "endpoints" },
    "websocket_endpoint": { "@id": "aars:websocketEndpoint", "@type": "@id", "@nest": "endpoints" },

    "realizes": "aars:realizes",
    "purpose": { "@id": "airo:hasPurpose", "@type": "@id" },
    "domain": { "@id": "airo:isAppliedWithinDomain", "@type": "@id" },
    "technique": { "@id": "airo:usesTechnique", "@type": "@id" },
    "user": { "@id": "airo:isUsedBy", "@type": "@id" },
    "subject": { "@id": "airo:affects", "@type": "@id" },
    "environment": { "@id": "airo:isUsedInEnvironment", "@type": "@id" },

    "intent": "aars:hasIntent",
    "goal_statement": "aars:goalStatement",
    "web": "https://schema.obquan.com/aars/cap/web#",
    "payment": "https://schema.obquan.com/aars/cap/payment#",
    "db": "https://schema.obquan.com/aars/cap/db#",
    "capabilities": { "@id": "aars:capability", "@type": "@vocab", "@container": "@set" },
    "constraints": "aars:hasConstraints",
    "max_spend_limit": { "@id": "aars:maxSpend", "@type": "xsd:decimal" },
    "currency": "aars:currency",
    "expiration_timestamp": { "@id": "aars:authorityExpires", "@type": "xsd:dateTime" },
    "allowed_geographies": { "@id": "aars:allowedGeography", "@container": "@set" },
    "forbidden_tools": { "@id": "aars:forbiddenTool", "@container": "@set" },

    "execution_limits": "@nest",
    "max_steps_per_task": { "@id": "aars:maxStepsPerTask", "@type": "xsd:integer", "@nest": "execution_limits" },
    "max_execution_time_seconds": { "@id": "aars:maxExecutionSeconds", "@type": "xsd:integer", "@nest": "execution_limits" },

    "data_classification": "@nest",
    "max_input_tier": { "@id": "aars:maxInputTier", "@nest": "data_classification" },
    "max_output_tier": { "@id": "aars:maxOutputTier", "@nest": "data_classification" },

    "data_boundaries": "aars:dataBoundary",
    "permitted_data_categories": { "@id": "aars:permittedDataCategory", "@type": "@id", "@container": "@set" },
    "prohibited_data_categories": { "@id": "aars:prohibitedDataCategory", "@type": "@id", "@container": "@set" },
    "lawful_basis": { "@id": "aars:lawfulBasis", "@type": "@id" },
    "data_categories": { "@id": "aars:dataCategory", "@type": "@id", "@container": "@set" },

    "failure_behavior": "@nest",
    "on_breach": { "@id": "aars:onBreach", "@type": "@vocab", "@nest": "failure_behavior" },
    "compensating_action": { "@id": "aars:compensatingAction", "@type": "@id", "@nest": "failure_behavior" },

    "capability_envelope": "aars:capabilityEnvelope",
    "permitted_mcp_servers": { "@id": "aars:permittedMcpServer", "@container": "@set" },
    "server_id": "aars:serverId",
    "allowed_tools": { "@id": "aars:allowedTool", "@container": "@set" },
    "delegation_allowlist": { "@id": "aars:mayDelegateTo", "@type": "@id", "@container": "@set" },
    "network_egress_allowlist": { "@id": "aars:egressAllowed", "@container": "@set" },

    "synthetic_content_disclosure": "@nest",
    "produces_synthetic_content": { "@id": "aars:producesSyntheticContent", "@nest": "synthetic_content_disclosure" },
    "marking_methods": { "@id": "aars:markingMethod", "@type": "@vocab", "@container": "@set", "@nest": "synthetic_content_disclosure" },

    "compliance": "@nest",
    "min_trust_threshold": { "@id": "aars:minTrustThreshold", "@nest": "compliance" },
    "standards_attested": { "@id": "aars:attestedStandard", "@type": "@vocab", "@container": "@set", "@nest": "compliance" },
    "eu_ai_act": { "@id": "aars:euAiAct", "@nest": "compliance" },
    "eu_ai_reg_id": "aars:euAiRegId",
    "risk_category": { "@id": "aars:declaredRiskTier", "@type": "@vocab" },
    "high_risk_area": { "@id": "aars:highRiskArea", "@type": "@vocab" },
    "gpai_status": { "@id": "aars:gpaiStatus", "@type": "@vocab" },
    "human_oversight_attestation": "aars:humanOversight",
    "oversight_method": "aars:oversightMethod",
    "supervisor_did": { "@id": "aars:supervisor", "@type": "@id" },
    "attestation_signature": "aars:signature",
    "compliance_standards": { "@id": "aars:attestedStandard", "@type": "@vocab", "@container": "@set" },
    "c2pa_declaration": "aars:c2paDeclaration",
    "c2pa_supported": "aars:c2paSupported",
    "watermarking_algorithm": "aars:watermarkingAlgorithm",
    "manifest_binding_method": "aars:manifestBindingMethod",
    "kill_switch": "aars:killSwitch",
    "supported": "aars:killSwitchSupported",
    "revocation_endpoint": { "@id": "aars:revocationEndpoint", "@type": "@id" },
    "kill_switch_endpoint": { "@id": "aars:revocationEndpoint", "@type": "@id" },

    "intent_hash": { "@id": "aars:intentDigest", "@type": "@id" },
    "mandate_digest": { "@id": "aars:mandateDigest", "@type": "@id" },
    "mandate_ref": { "@id": "aars:mandateRef", "@type": "@id" },
    "execution_bounds": "aars:bounds",
    "execution_envelope": "aars:envelope",
    "max_hops_remaining": { "@id": "aars:hopsRemaining", "@type": "xsd:integer" },
    "max_depth_remaining": { "@id": "aars:hopsRemaining", "@type": "xsd:integer" },
    "max_budget_remaining_usd": { "@id": "aars:budgetRemainingUsd", "@type": "xsd:decimal" },
    "max_records_allowed": { "@id": "aars:recordsAllowed", "@type": "xsd:integer" },
    "ttl_timestamp": { "@id": "aars:ttl", "@type": "xsd:dateTime" },

    "hops": { "@id": "aars:hop", "@container": "@set" },
    "hop_index": { "@id": "aars:hopIndex", "@type": "xsd:integer" },
    "agent_did": { "@id": "prov:wasAssociatedWith", "@type": "@id" },
    "timestamp": { "@id": "aars:dispatchedAt", "@type": "xsd:dateTime" },
    "signature": "aars:signature",
    "prov:used": { "@type": "@id" },
    "prov:generated": { "@type": "@id" },

    "delegation_context": "@nest",
    "sub": { "@id": "aars:onBehalfOf", "@type": "@id", "@nest": "delegation_context" },
    "act": {
      "@id": "aars:actor",
      "@nest": "delegation_context",
      "@context": { "sub": { "@id": "aars:actorAgent", "@type": "@id" } }
    },

    "trust_score_attestation": "aars:trustAttestation",
    "score": "aars:score",
    "updated_at": { "@id": "aars:validAt", "@type": "xsd:dateTime" },

    "revokes": { "@id": "aars:revokes", "@type": "@id" },
    "revoked_at": { "@id": "aars:revokedAt", "@type": "xsd:dateTime" },
    "revocation_authority": { "@id": "aars:revocationAuthority", "@type": "@id" },
    "reason": "aars:reason",

    "RiskLevelHigh": "eu-aiact:RiskLevelHigh",
    "RiskLevelTransparencyRequired": "eu-aiact:RiskLevelTransparencyRequired",
    "RiskLevelMinimal": "eu-aiact:RiskLevelMinimal",
    "RiskLevelProhibited": "eu-aiact:RiskLevelProhibited",
    "Biometrics": "aars:Biometrics",
    "LawEnforcement": "aars:LawEnforcement",
    "EmploymentAndWorkersManagement": "aars:EmploymentAndWorkersManagement",
    "CriticalInfrastructure": "aars:CriticalInfrastructure",
    "EducationAndVocationalTraining": "aars:EducationAndVocationalTraining",
    "AccessToEssentialServices": "aars:AccessToEssentialServices",
    "MigrationAsylumBorderControl": "aars:MigrationAsylumBorderControl",
    "AdministrationOfJusticeAndDemocraticProcesses": "aars:AdministrationOfJusticeAndDemocraticProcesses",
    "NotGpai": "aars:NotGpai",
    "Gpai": "aars:Gpai",
    "GpaiSystemicRisk": "aars:GpaiSystemicRisk",
    "FailClosed": "aars:FailClosed",
    "DegradeToReadOnly": "aars:DegradeToReadOnly",
    "IsolateAndPage": "aars:IsolateAndPage",
    "C2paContentCredential": "aars:C2paContentCredential",
    "StatisticalWatermark": "aars:StatisticalWatermark",
    "RdfMetadataSidecar": "aars:RdfMetadataSidecar",
    "GDPR": "aars:GDPR",
    "HIPAA": "aars:HIPAA",
    "SOC2TypeII": "aars:SOC2TypeII",
    "ISO27001": "aars:ISO27001",
    "COPPA": "aars:COPPA",

    "controller": { "@id": "https://www.w3.org/ns/did#controller", "@type": "@id", "@container": "@set" },
    "verificationMethod": { "@id": "https://www.w3.org/ns/did#verificationMethod", "@container": "@set" },
    "authentication": { "@id": "https://www.w3.org/ns/did#authentication", "@type": "@id", "@container": "@set" },
    "assertionMethod": { "@id": "https://www.w3.org/ns/did#assertionMethod", "@type": "@id", "@container": "@set" },
    "service": { "@id": "https://www.w3.org/ns/did#service", "@container": "@set" },
    "serviceEndpoint": { "@id": "https://www.w3.org/ns/did#serviceEndpoint", "@type": "@id" },
    "publicKeyMultibase": "https://w3id.org/security#publicKeyMultibase",
    "publicKeyJwk": "https://w3id.org/security#publicKeyJwk",
    "verifiableCredential": { "@id": "https://www.w3.org/2018/credentials#verifiableCredential", "@container": "@set" },
    "issuer": { "@id": "https://www.w3.org/2018/credentials#issuer", "@type": "@id" },
    "issuanceDate": { "@id": "https://www.w3.org/2018/credentials#issuanceDate", "@type": "xsd:dateTime" },
    "expirationDate": { "@id": "https://www.w3.org/2018/credentials#expirationDate", "@type": "xsd:dateTime" },
    "credentialSubject": "https://www.w3.org/2018/credentials#credentialSubject",
    "proof": "https://w3id.org/security#proof",
    "proofPurpose": "https://w3id.org/security#proofPurpose",
    "jws": "https://w3id.org/security#jws",
    "created": { "@id": "http://purl.org/dc/terms/created", "@type": "xsd:dateTime" },
    "AgentCommunicationService": "aars:AgentCommunicationService",
    "Ed25519VerificationKey2020": "https://w3id.org/security#Ed25519VerificationKey2020",
    "JsonWebSignature2020": "https://w3id.org/security#JsonWebSignature2020",
    "VerifiableCredential": "vc:VerifiableCredential",
    "EUAIActComplianceCredential": "aars:EUAIActComplianceCredential"
  }
}
